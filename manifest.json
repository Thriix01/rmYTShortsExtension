{
    "version": "1.0",
    "manifest_version": 3,
    "name": "Remove YT Shorts",
    "description": "Removes Occurences Of YT Shorts",
    "permissions":[
        "scripting",
        "webNavigation"
    ],
    "host_permissions":["https://www.youtube.com/"],
    "background":{
        "service_worker": "background.js",
        "type": "module"
    }
}